[Unit]
Description=Lunch Roulette API (FastAPI)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/lunch-roulette/backend
ExecStart=/home/ec2-user/lunch-roulette/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
